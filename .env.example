# ShiftPing – Environment Variables
# Copy to .env and fill in values.

# Flask
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-admin-token
LOG_LEVEL=INFO
TIMEZONE=Asia/Jerusalem
APP_BASE_URL=http://localhost:5000

# Database: true = in-memory (local demo); false = Firebase Firestore
USE_MOCK_DB=true

# Firebase (required when USE_MOCK_DB=false)
# Option A: path to service account JSON file (local)
FIREBASE_CREDENTIALS_PATH=
# Option B: raw JSON string (Vercel / CI) – paste minified service account JSON
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Set true in production after webhook URL is stable
TWILIO_WEBHOOK_VALIDATE=false

# Chief nurse WhatsApp (optional if an employee has role=chief)
CHIEF_NURSE_PHONE=+972501111001

# Scheduling
SHIFTS_PER_DAY=3
NURSES_PER_SHIFT=2
